# ==========================================
# ASENTUM TESTNET BOT CONFIGURATION
# ==========================================

# Your Private Key or Seed Mnemonic (Leave empty if using wallets.txt)
PRIVATE_KEY=""
PUBLIC_KEY=""

# RPC Endpoint (Default public testnet RPC)
RPC_URL="https://testnet.asentum.com"

# Recipient address for Send ASE task (Leave empty to use daisy-chain or default)
RECIPIENT_ADDRESS=""

# Enable / Disable specific tasks (true / false)
# - DeFi tasks (Transfer, Swap, Liquidity, AsePad): randomized small amounts (< 0.13 ASE)
# - Game tasks: exact minimum requirement required by each smart contract
ENABLE_SEND_ASE=true
ENABLE_AURAS_SWAP=true
ENABLE_ASEDEX_SWAP=true
ENABLE_AURAS_LIQUIDITY=true
ENABLE_ASEDEX_LIQUIDITY=true
ENABLE_SOCIAL_POST=true
ENABLE_CONTRACT_DEPLOY=true
ENABLE_ASEPAD_BUY=true
ENABLE_ASEBET=true
ENABLE_TREASURE_HUNT=true
ENABLE_LOTO_BUY=true
ENABLE_ASEFLIP=true
ENABLE_ANOTHER_SHOOTER=true

# Daily Scheduler Cron expression (Default: Every day at 01:00 AM local time)
CRON_SCHEDULE="0 0 1 * * *"

# Delay between accounts in multi-wallet mode (seconds)
DELAY_BETWEEN_WALLETS_SEC="8"
