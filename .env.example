# ==========================================
# ASENTUM TESTNET BOT CONFIGURATION
# ==========================================

# Your Private Key or Seed Mnemonic
# Format options:
# 1) 64-char Hex Seed / Private Key (e.g. 0xabcdef... or abcdef...)
# 2) 12 or 24-word Mnemonic Phrase (e.g. word1 word2 word3 ... word12)
# 3) Dilithium Secret Key (if exported full SK + PK)
PRIVATE_KEY=""

# Public Key (Only required if using raw Dilithium SK + PK pair, otherwise leave empty)
PUBLIC_KEY=""

# RPC Endpoint (Default public testnet RPC)
RPC_URL="https://testnet.asentum.com"

# Recipient address for Send ASE task (Leave empty to use default community faucet / burn address)
RECIPIENT_ADDRESS=""

# Amount of ASE to send in daily transfer task (e.g. 0.001)
SEND_AMOUNT_ASE="0.001"

# Amount of ASE to swap on Auras DEX per run (e.g. 0.01)
SWAP_AMOUNT_ASE="0.01"

# Enable / Disable specific tasks (true / false)
ENABLE_SEND_ASE=true
ENABLE_AURAS_SWAP=true
ENABLE_AURAS_LIQUIDITY=true
ENABLE_SOCIAL_POST=true
ENABLE_CONTRACT_DEPLOY=true
ENABLE_ASEPAD_BUY=true
ENABLE_ASEPAD_SELL=true
ASEPAD_BUY_AMOUNT="0.005"

# Daily Scheduler Cron expression (Default: Every day at 01:00 AM local time)
# Format: second(opt) minute hour day month day-of-week
CRON_SCHEDULE="0 0 1 * * *"

# Delay between accounts in multi-wallet mode (seconds)
DELAY_BETWEEN_WALLETS_SEC="8"
